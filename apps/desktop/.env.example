# CyKrome Distributed Systems. Defaults to production.
VITE_CDS_BASE_URL=https://api.cykrome.com
# CDS product id of "Drift Pro". An unexpired Ownership of this product unlocks Pro.
VITE_DRIFT_PRO_PRODUCT_ID=

# Wallpaper providers, in priority order (packages/wallpapers/src/config.ts). Swapping or adding
# one is an env change. A provider without what it needs is skipped; Drift's generated
# wallpapers are always the fallback.
VITE_WALLPAPER_PROVIDERS=coverr,nasa,drift
# Coverr (free stock video loops). Free "Demo" keys allow 50 requests an hour; a paid Coverr
# plan raises the same key to 2,000. Get one at https://coverr.co/developers.
VITE_COVERR_API_KEY=
