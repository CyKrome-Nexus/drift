# CyKrome Distributed Systems. Defaults to production.
EXPO_PUBLIC_CDS_BASE_URL=https://api.cykrome.com
# CDS product id of "Drift Pro". An unexpired Ownership of this product unlocks Pro.
EXPO_PUBLIC_DRIFT_PRO_PRODUCT_ID=

# Wallpaper providers, in priority order (packages/wallpapers/src/config.ts). Swapping or adding
# one is an env change. A provider without what it needs is skipped; Drift's generated
# wallpapers are always the fallback.
EXPO_PUBLIC_WALLPAPER_PROVIDERS=pexels,pixabay,drift
# Users bring their own Pexels and Pixabay keys (the welcome screen, Settings › Wallpaper sources);
# release builds ship with none. For development only, a key here is used until the user saves one.
EXPO_PUBLIC_PEXELS_API_KEY=
EXPO_PUBLIC_PIXABAY_API_KEY=
# Optional extra provider: add `coverr` (key from https://coverr.co/developers) to WALLPAPER_PROVIDERS.
EXPO_PUBLIC_COVERR_API_KEY=
