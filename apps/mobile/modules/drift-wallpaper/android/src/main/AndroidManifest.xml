<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Optional so devices without live wallpapers can still install Drift. -->
  <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

  <application>
    <service
      android:name="com.cykrome.drift.wallpaper.DriftWallpaperService"
      android:exported="true"
      android:label="@string/drift_wallpaper_label"
      android:permission="android.permission.BIND_WALLPAPER">
      <intent-filter>
        <action android:name="android.service.wallpaper.WallpaperService" />
      </intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/drift_wallpaper" />
    </service>
  </application>
</manifest>
